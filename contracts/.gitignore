# Dependencies
lib/
node_modules/

# Build artifacts
out/
cache/
broadcast/

# Artifacts of the real-v4 and audit configs, which compile the shared source graph under a second
# solc and so are kept out of `out/` entirely (see foundry.v4.toml). They are written under
# `forge-cache/`, which every branch has ignored since 2026-01-14; these four entries cover
# the directories left at the repo root by a checkout that ran either config before that move.
out-v4/
cache-v4/
out-audit/
cache-audit/

# Internal docs (promote to docs/spec/ or docs/examples/ when ready)
docs/*
!docs/spec/
!docs/examples/
# The pre-mainnet checklist is neither a spec nor an example, and it is the one document here that
# is useless if it is not in the repo: its whole purpose is to be found and read before a mainnet
# deploy by someone who does not already know it exists (noesis-451).
!docs/PRE-MAINNET-CHECKLIST.md
archive/
reference/

# Environment variables
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Foundry
forge-cache/
foundry.lock

# Claude Code
.claude/

# Local dev-chain deploy artifact — regenerated every `pnpm chain:deploy`, non-deterministic
# addresses (CreateX salts derived from block.timestamp). Sepolia deployment records stay tracked.
deployments/anvil.json

# Reports
reports/
CLAUDE.md
STANDARDIZED_EVENTS_SPEC.md
deployments/anvil-seed.json
