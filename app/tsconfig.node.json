{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  // `src/lib/share/origin.ts` is listed because `vite.config.ts` imports it: the share-card origin
  // is resolved by the build, and the rules for resolving it are unit-tested with the rest of the
  // share-card code rather than living unreachable inside this config.
  "include": ["vite.config.ts", "precache.globs.ts", "src/lib/share/origin.ts"]
}
